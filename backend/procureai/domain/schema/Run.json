{
  "$defs": {
    "ApprovalRequirements": {
      "additionalProperties": false,
      "properties": {
        "negotiation_send": {
          "default": true,
          "title": "Negotiation Send",
          "type": "boolean"
        },
        "po_generation": {
          "default": true,
          "title": "Po Generation",
          "type": "boolean"
        }
      },
      "title": "ApprovalRequirements",
      "type": "object"
    },
    "Escalation": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "reason"
      ],
      "title": "Escalation",
      "type": "object"
    },
    "FieldChange": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "title": "Before"
        },
        "after": {
          "title": "After"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "FieldChange",
      "type": "object"
    },
    "NegotiationBoundaries": {
      "additionalProperties": false,
      "properties": {
        "default_ask_pct": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "8",
          "description": "Opening ask: unit_price \u00d7 (1 \u2212 pct/100) (D17)",
          "title": "Default Ask Pct"
        },
        "max_discount_ask_pct": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "10",
          "title": "Max Discount Ask Pct"
        },
        "min_lead_time_days": {
          "default": 7,
          "minimum": 0,
          "title": "Min Lead Time Days",
          "type": "integer"
        },
        "max_rounds": {
          "default": 2,
          "description": "Hard cap per supplier (G2)",
          "maximum": 2,
          "minimum": 1,
          "title": "Max Rounds",
          "type": "integer"
        },
        "negotiate_top_n": {
          "default": 2,
          "description": "Negotiate with the top N eligible suppliers, sequentially (D17)",
          "minimum": 1,
          "title": "Negotiate Top N",
          "type": "integer"
        }
      },
      "title": "NegotiationBoundaries",
      "type": "object"
    },
    "NegotiationOffer": {
      "additionalProperties": false,
      "description": "Price and lead time only (D7).",
      "properties": {
        "unit_price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Unit Price"
        },
        "lead_time_days": {
          "minimum": 0,
          "title": "Lead Time Days",
          "type": "integer"
        }
      },
      "required": [
        "unit_price",
        "lead_time_days"
      ],
      "title": "NegotiationOffer",
      "type": "object"
    },
    "NegotiationRole": {
      "enum": [
        "buyer",
        "supplier"
      ],
      "title": "NegotiationRole",
      "type": "string"
    },
    "NegotiationStatus": {
      "enum": [
        "open",
        "accepted",
        "rejected",
        "escalated",
        "closed"
      ],
      "title": "NegotiationStatus",
      "type": "string"
    },
    "NegotiationThread": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "supplier_id": {
          "title": "Supplier Id",
          "type": "string"
        },
        "turns": {
          "items": {
            "$ref": "#/$defs/NegotiationTurn"
          },
          "title": "Turns",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/NegotiationStatus",
          "default": "open"
        },
        "boundaries": {
          "$ref": "#/$defs/NegotiationBoundaries"
        },
        "original_offer": {
          "anyOf": [
            {
              "$ref": "#/$defs/NegotiationOffer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Supplier's quoted price/lead time before negotiation"
        },
        "current_offer": {
          "anyOf": [
            {
              "$ref": "#/$defs/NegotiationOffer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Supplier's latest standing offer"
        }
      },
      "required": [
        "run_id",
        "supplier_id",
        "boundaries"
      ],
      "title": "NegotiationThread",
      "type": "object"
    },
    "NegotiationTurn": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/$defs/NegotiationRole"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "offer": {
          "anyOf": [
            {
              "$ref": "#/$defs/NegotiationOffer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approved_by_human": {
          "default": false,
          "title": "Approved By Human",
          "type": "boolean"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "role",
        "message",
        "ts"
      ],
      "title": "NegotiationTurn",
      "type": "object"
    },
    "NormalizedQuote": {
      "additionalProperties": false,
      "description": "Output of the Document Agent. Untrusted content, already structured.",
      "properties": {
        "quote_id": {
          "title": "Quote Id",
          "type": "string"
        },
        "doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RawDocument this quote was extracted from (set by the Document Agent)",
          "title": "Doc Id"
        },
        "supplier_id": {
          "title": "Supplier Id",
          "type": "string"
        },
        "supplier_name": {
          "title": "Supplier Name",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/QuoteSource"
        },
        "unit_price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Unit Price"
        },
        "currency": {
          "description": "ISO-4217 code",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "quantity_quoted": {
          "exclusiveMinimum": 0,
          "title": "Quantity Quoted",
          "type": "integer"
        },
        "moq": {
          "minimum": 0,
          "title": "Moq",
          "type": "integer"
        },
        "lead_time_days": {
          "minimum": 0,
          "title": "Lead Time Days",
          "type": "integer"
        },
        "payment_terms": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payment Terms"
        },
        "shipping_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Shipping Cost"
        },
        "discount_pct": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Discount Pct"
        },
        "validity_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validity Date"
        },
        "capacity_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity Units"
        },
        "llm_stated_total": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total as written in the document; only used for mismatch detection (G1)",
          "title": "Llm Stated Total"
        },
        "field_confidence": {
          "additionalProperties": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "title": "Field Confidence",
          "type": "object"
        },
        "raw_excerpt": {
          "default": "",
          "title": "Raw Excerpt",
          "type": "string"
        },
        "negotiated_offer": {
          "anyOf": [
            {
              "$ref": "#/$defs/NegotiationOffer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accepted counter-offer; the engine costs with it, originals stay for audit (D17)"
        }
      },
      "required": [
        "quote_id",
        "supplier_id",
        "supplier_name",
        "source",
        "unit_price",
        "currency",
        "quantity_quoted",
        "moq",
        "lead_time_days"
      ],
      "title": "NormalizedQuote",
      "type": "object"
    },
    "PendingHuman": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/PendingHumanKind"
        },
        "quote_ids": {
          "items": {
            "type": "string"
          },
          "title": "Quote Ids",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "quote_ids",
        "message"
      ],
      "title": "PendingHuman",
      "type": "object"
    },
    "PendingHumanKind": {
      "enum": [
        "extraction",
        "calc_mismatch",
        "negotiation_approval",
        "po_approval"
      ],
      "title": "PendingHumanKind",
      "type": "string"
    },
    "ProcurementConfig": {
      "additionalProperties": false,
      "properties": {
        "weights": {
          "$ref": "#/$defs/ScoringWeights"
        },
        "thresholds": {
          "$ref": "#/$defs/Thresholds",
          "default": {
            "max_defect_rate": 0.05,
            "min_confidence": 0.85,
            "tie_margin": 2.0
          }
        },
        "negotiation": {
          "$ref": "#/$defs/NegotiationBoundaries"
        },
        "approvals": {
          "$ref": "#/$defs/ApprovalRequirements",
          "default": {
            "negotiation_send": true,
            "po_generation": true
          }
        },
        "tax_rate_pct": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Tax Rate Pct"
        }
      },
      "required": [
        "weights",
        "negotiation"
      ],
      "title": "ProcurementConfig",
      "type": "object"
    },
    "ProcurementRequest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "product": {
          "title": "Product",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "required_by": {
          "format": "date",
          "title": "Required By",
          "type": "string"
        },
        "budget": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Budget"
        },
        "currency": {
          "description": "ISO-4217 code",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "version": {
          "default": 1,
          "description": "Increments on every interrupt",
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "product",
        "quantity",
        "required_by",
        "budget",
        "currency",
        "created_at"
      ],
      "title": "ProcurementRequest",
      "type": "object"
    },
    "PurchaseOrder": {
      "additionalProperties": false,
      "description": "Built only by the orchestrator's request_po (preview) / approve_po (final) path (G5).\n\nA preview (Run.po_preview) has po_number, approved_by and approved_at = None; the final\ndocument (Run.purchase_order) has all three set. No agent or tool constructs this model.",
      "properties": {
        "po_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None on the preview; assigned at human approval",
          "title": "Po Number"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "request_version": {
          "description": "Request version the totals were costed at",
          "minimum": 1,
          "title": "Request Version",
          "type": "integer"
        },
        "supplier": {
          "$ref": "#/$defs/SupplierRef"
        },
        "currency": {
          "description": "ISO-4217 code",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "line_items": {
          "items": {
            "$ref": "#/$defs/PurchaseOrderLine"
          },
          "minItems": 1,
          "title": "Line Items",
          "type": "array"
        },
        "totals": {
          "$ref": "#/$defs/PurchaseOrderTotals"
        },
        "lead_time_days": {
          "description": "Effective (negotiated if any) lead time",
          "minimum": 0,
          "title": "Lead Time Days",
          "type": "integer"
        },
        "payment_terms": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "As stated on the supplier's quote",
          "title": "Payment Terms"
        },
        "negotiated": {
          "default": false,
          "description": "True when unit price / lead time come from an accepted counter-offer",
          "title": "Negotiated",
          "type": "boolean"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None on the preview",
          "title": "Approved By"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None on the preview",
          "title": "Approved At"
        }
      },
      "required": [
        "run_id",
        "request_version",
        "supplier",
        "currency",
        "line_items",
        "totals",
        "lead_time_days"
      ],
      "title": "PurchaseOrder",
      "type": "object"
    },
    "PurchaseOrderLine": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "unit_price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Unit Price"
        },
        "line_total": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Line Total"
        }
      },
      "required": [
        "description",
        "quantity",
        "unit_price",
        "line_total"
      ],
      "title": "PurchaseOrderLine",
      "type": "object"
    },
    "PurchaseOrderTotals": {
      "additionalProperties": false,
      "properties": {
        "subtotal": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Subtotal"
        },
        "discount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Discount"
        },
        "shipping": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Shipping"
        },
        "tax": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Tax"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Total"
        }
      },
      "required": [
        "subtotal",
        "discount",
        "shipping",
        "tax",
        "total"
      ],
      "title": "PurchaseOrderTotals",
      "type": "object"
    },
    "QuoteChecks": {
      "additionalProperties": false,
      "properties": {
        "moq_ok": {
          "title": "Moq Ok",
          "type": "boolean"
        },
        "lead_time_ok": {
          "title": "Lead Time Ok",
          "type": "boolean"
        },
        "budget_ok": {
          "title": "Budget Ok",
          "type": "boolean"
        },
        "math_ok": {
          "title": "Math Ok",
          "type": "boolean"
        },
        "capacity_ok": {
          "default": true,
          "title": "Capacity Ok",
          "type": "boolean"
        }
      },
      "required": [
        "moq_ok",
        "lead_time_ok",
        "budget_ok",
        "math_ok"
      ],
      "title": "QuoteChecks",
      "type": "object"
    },
    "QuoteSource": {
      "enum": [
        "pdf",
        "xlsx",
        "email"
      ],
      "title": "QuoteSource",
      "type": "string"
    },
    "RawDocument": {
      "additionalProperties": false,
      "description": "A supplier document already reduced to plain text (parsed locally, never sent as binary).",
      "properties": {
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/QuoteSource"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "filename",
        "source",
        "text"
      ],
      "title": "RawDocument",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "request_version": {
          "minimum": 1,
          "title": "Request Version",
          "type": "integer"
        },
        "ranked": {
          "description": "supplier_ids, best first",
          "items": {
            "type": "string"
          },
          "title": "Ranked",
          "type": "array"
        },
        "recommended_supplier_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recommended Supplier Id"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "change_explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Explanation"
        },
        "escalation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Escalation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "run_id",
        "request_version",
        "ranked",
        "recommended_supplier_id",
        "rationale"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "ReplanImpact": {
      "additionalProperties": false,
      "description": "Structured diff produced by an interrupt: request v{from} \u2192 v{to}, per-supplier effects, engine summary.",
      "properties": {
        "from_version": {
          "minimum": 1,
          "title": "From Version",
          "type": "integer"
        },
        "to_version": {
