{
  "$defs": {
    "NegotiationBoundaries": {
      "additionalProperties": false,
      "properties": {
        "default_ask_pct": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "8",
          "description": "Opening ask: unit_price \u00d7 (1 \u2212 pct/100) (D17)",
          "title": "Default Ask Pct"
        },
        "max_discount_ask_pct": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "10",
          "title": "Max Discount Ask Pct"
        },
        "min_lead_time_days": {
          "default": 7,
          "minimum": 0,
          "title": "Min Lead Time Days",
          "type": "integer"
        },
        "max_rounds": {
          "default": 2,
          "description": "Hard cap per supplier (G2)",
          "maximum": 2,
          "minimum": 1,
          "title": "Max Rounds",
          "type": "integer"
        },
        "negotiate_top_n": {
          "default": 2,
          "description": "Negotiate with the top N eligible suppliers, sequentially (D17)",
          "minimum": 1,
          "title": "Negotiate Top N",
          "type": "integer"
        }
      },
      "title": "NegotiationBoundaries",
      "type": "object"
    },
    "NegotiationOffer": {
      "additionalProperties": false,
      "description": "Price and lead time only (D7).",
      "properties": {
        "unit_price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Unit Price"
        },
        "lead_time_days": {
          "minimum": 0,
          "title": "Lead Time Days",
          "type": "integer"
        }
      },
      "required": [
        "unit_price",
        "lead_time_days"
      ],
      "title": "NegotiationOffer",
      "type": "object"
    },
    "NegotiationRole": {
      "enum": [
        "buyer",
        "supplier"
      ],
      "title": "NegotiationRole",
      "type": "string"
    },
    "NegotiationStatus": {
      "enum": [
        "open",
        "accepted",
        "rejected",
        "escalated",
        "closed"
      ],
      "title": "NegotiationStatus",
      "type": "string"
    },
    "NegotiationTurn": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/$defs/NegotiationRole"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "offer": {
          "anyOf": [
            {
              "$ref": "#/$defs/NegotiationOffer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approved_by_human": {
          "default": false,
          "title": "Approved By Human",
          "type": "boolean"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "role",
        "message",
        "ts"
      ],
      "title": "NegotiationTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "supplier_id": {
      "title": "Supplier Id",
      "type": "string"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/NegotiationTurn"
      },
      "title": "Turns",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/NegotiationStatus",
      "default": "open"
    },
    "boundaries": {
      "$ref": "#/$defs/NegotiationBoundaries"
    },
    "original_offer": {
      "anyOf": [
        {
          "$ref": "#/$defs/NegotiationOffer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Supplier's quoted price/lead time before negotiation"
    },
    "current_offer": {
      "anyOf": [
        {
          "$ref": "#/$defs/NegotiationOffer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Supplier's latest standing offer"
    }
  },
  "required": [
    "run_id",
    "supplier_id",
    "boundaries"
  ],
  "title": "NegotiationThread",
  "type": "object"
}
