# ProcureAI backend configuration. Copy to .env and fill in.

# mock = no external calls, agents return fixture output (default, demo-safe)
# live = call the organiser LLM gateway / OpenClaw
MODE=mock

# Organiser Ollama-compatible LLM gateway (POST {LLM_GATEWAY_URL}/api/chat).
# Never Bedrock directly (PLAN.md D4).
LLM_GATEWAY_URL=https://example-gateway.invalid
LLM_GATEWAY_API_KEY=
# Model alias understood by the gateway (maps to Claude Sonnet 4.5 on Bedrock)
LLM_MODEL=sonnet4.5:latest
# Gateway caps output at ~200 tokens unless options.num_predict is raised
LLM_NUM_PREDICT=2048

# OpenClaw gateway on the Lightsail box (starter kit default port 18789)
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_TOKEN=

# Frontend origins allowed by CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173"]
