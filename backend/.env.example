# ProcureAI backend configuration. Copy to .env and fill in.

# mock = no external calls, agents return fixture output (default, demo-safe)
# live = call the organiser LLM gateway / OpenClaw
MODE=mock

# Organiser Ollama-compatible LLM gateway (POST {LLM_GATEWAY_URL}/api/chat).
# Never Bedrock directly (PLAN.md D4).
LLM_GATEWAY_URL=https://example-gateway.invalid
LLM_GATEWAY_API_KEY=
# Model alias understood by the gateway (maps to Claude Sonnet 4.5 on Bedrock)
LLM_MODEL=sonnet4.5:latest
# Gateway caps output at 256 tokens unless options.num_predict is raised (docs/INFRA.md)
LLM_NUM_PREDICT=2048
# replay_or_record (default) | record (always call) | replay_only (offline: fail on a cache miss)
LLM_CACHE_MODE=replay_or_record
LLM_TIMEOUT_S=60
# Our own cap on the serialised request body. The kit's ~8 KiB WAF limit does not apply to the organiser
# gateway (OpenClaw sends 52-60 KB turns to it successfully, docs/OPENCLAW.md), so 32000 is comfortable.
LLM_MAX_BODY_BYTES=32000

# Which route live agent calls take (PLAN.md D11, option C):
#   gateway  = straight to the organiser gateway (default for local dev)
#   openclaw = OpenClaw's /v1/chat/completions on the Lightsail box (dedicated tool-less `procureai` agent),
#              with the direct gateway as automatic fallback when OpenClaw is unreachable
LLM_BACKEND=gateway
# OpenClaw gateway: loopback on the box; locally reach it through `just tunnel` (ssh -L 18789)
OPENCLAW_URL=http://127.0.0.1:18789
# gateway.auth.token from ~/.openclaw/openclaw.json on the box. Lives here and there only; never committed.
OPENCLAW_TOKEN=
# Agent target ("openclaw/<agentId>"), not a provider model. `procureai` = no tools, no bootstrap, no memory.
OPENCLAW_MODEL=openclaw/procureai
# OpenClaw adds ~0.3-1 s over the gateway and restarts take ~15 s; the fallback covers a timeout
OPENCLAW_TIMEOUT_S=90
# Tasks that take the OpenClaw route (comma list); anything else goes straight to the gateway (PLAN.md D29).
# Remove a task here if its prose keeps tripping the number guard through OpenClaw.
OPENCLAW_TASKS=extract,explain,explain_diff,draft,negotiation_verdict

# Run persistence: empty = in-memory only (a restart clears the runs; tests and local dev). A directory
# mirrors every run to <dir>/<run_id>/{run.json,events.jsonl} and loads them back on startup (docs/DEPLOY.md).
# On the box: RUN_STORE_DIR=/home/ubuntu/procureai/data/runs
RUN_STORE_DIR=

# Frontend origins allowed by CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173"]
